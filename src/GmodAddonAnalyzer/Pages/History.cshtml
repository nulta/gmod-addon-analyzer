@page
@model GmodAddonAnalyzer.Pages.HistoryModel
@{
    ViewData["Title"] = "History";
}

<h1>History</h1>

@if (Model.Runs.Count == 0)
{
    <p class="muted">No submissions yet.</p>
}
else
{
    <table>
        <thead>
            <tr><th>When</th><th>Addon ID</th><th>Status</th><th>Submitted by</th></tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Runs)
        {
            <tr>
                <td>@r.SubmittedAt.ToString("u")</td>
                <td><a asp-page="/Report" asp-route-id="@r.AddonId">@r.AddonId</a></td>
                <td><span class="badge badge-@r.Status">@r.Status</span></td>
                <td class="muted">@(r.SubmittedByIp ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
}